# Copy this file to .env and fill in real values.

# PostgreSQL connection string (psycopg3 driver).
DATABASE_URL=postgresql+psycopg://studymate_user:studymate_pass@localhost:5432/studymate

# JWT signing secret. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-random-secret

# Ollama local LLM (defaults shown). Change the models to ones you have pulled.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
# Per-request timeout in seconds for model loading + generation.
OLLAMA_REQUEST_TIMEOUT=300

# PDF uploads (defaults shown). uploads/ is gitignored.
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760
